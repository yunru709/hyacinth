{
  "name": "hyacinth-ai",
  "version": "0.9.62",
  "description": "Hyacinth 🪻 — multi-provider AI agent with tool system and context management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hyacinth": "dist/bootstrap.js"
  },
  "scripts": {
    "build": "tsc && node scripts/clean-stale.cjs && node scripts/copy-prompts.cjs && node scripts/gen-bg-manifest.cjs && node scripts/copy-webui.cjs && node scripts/clean-tests.cjs && node scripts/clean-maps.cjs && node scripts/copy-grammars.cjs",
    "dev": "tsc --watch",
    "gen:theme": "node scripts/gen-theme-css.cjs",
    "start": "node dist/index.js",
    "start:win": "chcp 65001 > nul && node dist/index.js",
    "test": "vitest run",
    "smoke": "node scripts/smoke-assembly.mjs",
    "test:watch": "vitest",
    "verify:layers": "node scripts/verify-layers.mjs",
    "setup:llamacpp": "powershell -ExecutionPolicy Bypass -File scripts/setup-llamacpp.ps1",
    "webui": "node dist/index.js webui",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File scripts/desktop-build.ps1",
    "desktop": "powershell -ExecutionPolicy Bypass -File scripts/desktop-build.ps1 -SkipBuild -Launch",
    "gen:webui-css": "node scripts/gen-webui-css.cjs",
    "gen:highlight": "node scripts/gen-highlight.cjs",
    "gen:icons": "node scripts/gen-icons.cjs",
    "gen:desktop-icon": "node scripts/gen-desktop-icon.cjs",
    "prepublishOnly": "pnpm build && pnpm test && pnpm verify:layers"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "mcp",
    "anthropic",
    "openai",
    "deepseek"
  ],
  "author": "孑遗",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@clack/prompts": "^1.4.0",
    "@earendil-works/pi-tui": "^0.75.4",
    "@fastify/compress": "^9.2.2",
    "@fastify/static": "^9.1.3",
    "@google/genai": "^2.6.0",
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "fastify": "^5.8.5",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.12.0",
    "openai": "^6.39.0",
    "picocolors": "^1.1.1",
    "sharp": "^0.35.0",
    "sherpa-onnx-node": "2.0.0",
    "web-tree-sitter": "0.27.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.1",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "tailwindcss": "4.3.1",
    "tree-sitter-c": "0.23.4",
    "tree-sitter-cli": "0.27.0",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "undici-types": "^7.24.6",
    "vitest": "^4.1.7"
  }
}
