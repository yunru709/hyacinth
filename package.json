{
  "name": "hyacinth-ai",
  "version": "0.9.14",
  "description": "Hyacinth 🪻 — multi-provider AI agent with tool system and context management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hyacinth": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-prompts.cjs && node scripts/clean-tests.cjs && node scripts/clean-maps.cjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:win": "chcp 65001 > nul && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:llamacpp": "powershell -ExecutionPolicy Bypass -File scripts/setup-llamacpp.ps1"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "mcp",
    "anthropic",
    "openai",
    "deepseek"
  ],
  "author": "孑遗",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@clack/prompts": "^1.4.0",
    "@earendil-works/pi-tui": "^0.75.4",
    "@fastify/static": "^9.1.3",
    "@google/genai": "^2.6.0",
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "fastify": "^5.8.5",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.12.0",
    "openai": "^6.39.0",
    "picocolors": "^1.1.1",
    "sharp": "^0.35.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0",
    "chrome-devtools-mcp": "^1.2.0",
    "mcp-chrome-bridge": "^1.0.31"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "undici-types": "^7.24.6",
    "vitest": "^4.1.7"
  }
}
