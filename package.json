{
  "name": "deepthink",
  "version": "0.9.2",
  "description": "DeepThink — multi-provider AI agent with multi-provider support, tool system, and context management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "deepthink": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-prompts.cjs && node scripts/clean-tests.cjs && node scripts/clean-maps.cjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:win": "chcp 65001 > nul && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:llamacpp": "powershell -ExecutionPolicy Bypass -File scripts/setup-llamacpp.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@clack/prompts": "^1.4.0",
    "@earendil-works/pi-tui": "^0.75.4",
    "@google/genai": "^2.6.0",
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "fastify": "^5.8.5",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.39.0",
    "picocolors": "^1.1.1",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "undici-types": "^7.24.6",
    "vitest": "^4.1.7"
  }
}
