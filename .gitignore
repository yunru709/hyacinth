# Compiled output
dist/

# llama.cpp embedded directory (source + build artifacts, several GB)
libs/

# GGUF model files (several GB each)
models/

# Node modules
node_modules/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/

# Per-user config (auto-generated on first run)
.agent/

# OS
.DS_Store
Thumbs.db

# 本地打包产物（npm pack 生成的 .tgz，不应提交）
*.tgz
# 生成产物（用户环境 ~/.agent/generation，源码目录不应残留）
/outputs/generation/
tsconfig.tsbuildinfo

# Training 数据库（本地运行产物）
*.db
!docs/**/*.db

# 调试残留（vitest 输出重定向文件，不应提交）
vt-*.txt

# agent 生成的架构报告（非源码产物，不应入库；含调试残留文件）
arch-report/
