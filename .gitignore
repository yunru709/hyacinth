dist/

# llama.cpp embedded directory (source + build artifacts, several GB)
libs/

# GGUF model files (several GB each)
models/

# 兜底：万一 GGUF 权重 / llama.cpp 源码不在 models/ 或 libs/ 里（09-22 补）
*.gguf
llama.cpp/


# Node modules
node_modules/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/

# Per-user config (auto-generated on first run)
.agent/

# Command Code 本地配置/学习数据
.commandcode/

# OS
.DS_Store
Thumbs.db

# 本地打包产物（npm pack 生成的 .tgz，不应提交）
*.tgz
# 生成产物 / 本地调试产物（用户环境 ~/.agent/generation、桌面壳探针的输出等）
# ⚠️ 用整目录而不是逐个白名单：outputs/ 下**没有任何被跟踪的文件**（2026-10-16 核对），
#    而逐个列会让每次新增一类调试输出就在 git status 里冒一批未跟踪文件 ✗
/outputs/
tsconfig.tsbuildinfo

# docs/ 下的**新增**研究/草稿不入库（用户 2026-10-16 裁定：docs 里的东西都可以不入库）
# ⚠️ .gitignore 不影响**已跟踪**文件 ⇒ 已入库的那 13 份 docs 保持跟踪，不会被删
/docs/

# .NET 桌面壳的构建产物（源码在 desktop/native-shell/，产物不入库）
desktop/native-shell/bin/
desktop/native-shell/obj/
desktop/native-shell/out/
desktop/native-shell/out-standalone/
desktop/native-shell/pub-out/
# 绿色版桌面包（约 1 GB：自带 node + node_modules）—— 本地产物，不入库
desktop/dist/

# Training 数据库（本地运行产物）
*.db
!docs/**/*.db

# 调试残留（vitest 输出重定向文件，不应提交）
vt-*.txt

# agent 生成的架构报告（非源码产物，不应入库；含调试残留文件）
arch-report/
