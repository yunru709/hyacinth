hyacinth-desktop.cmd

# IDE / dev config
.claude/
.trae/

# OS
.DS_Store
Thumbs.db

# Debug residue (vitest output redirect files; gitignored but must also be npmignored)
vt-*.txt

# 临时脚本残留（本地 scratch，绝不进包）—— 同 vt-*.txt 的教训：gitignore ≠ npmignore
*.tmp.mjs
*.tmp.cjs

# Test-only setup helpers (vitest bootstrap, compiled into dist) - not for the published package
dist/test-setup.js
dist/test-setup.d.ts

# 本地调试残留 / 本地数据 / dev 配置 —— 绝不进包（2026-10-29 发布前补：
# gitignore 里有但 npmignore 没同步，实测 `npm pack` 会把 .tmp-* 和 .commandcode/ 带上）
.tmp*
tmp/
.commandcode/
arch-report/
/outputs/
*.log
*.wav
.github/
.gitattributes

# 2026-10-31 发布卫生：开发期目录，绝不进包（实测 npm pack 会把它们带上：tools-dev 135 / shots 36 / _auto_test 8 / plugins 5 / model-repo 3 个文件）
# 前导 `/` 锚定根级，避免误伤 dist/plugins 等编译产物
